ADROBOT_DATABASE_URL=postgresql+psycopg://adrobot:adrobot@127.0.0.1:55432/adrobot
ADROBOT_KEITARO_BASE_URL=https://your-keitaro.example
ADROBOT_KEITARO_API_KEY=
